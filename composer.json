{
  "name": "sherrykisilu/wikiqa",
  "description": "Quality and documentation toolkit for MediaWiki extensions.",
  "type": "mediawiki-extension",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "MediaWiki\\Extension\\WikiQA\\": "extension/includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MediaWiki\\Extension\\WikiQA\\Tests\\": "extension/tests/phpunit/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test:php": "phpunit --bootstrap extension/tests/phpunit/bootstrap.php extension/tests/phpunit",
    "lint:php": "php -l extension/includes/ChecklistRenderer.php && php -l extension/includes/Hooks.php && php -l extension/tests/phpunit/ChecklistRendererTest.php"
  }
}
